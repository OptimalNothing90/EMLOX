{
    "_comment": "=== EMHASS Configuration for Sungrow Battery Control ===",
    "_info": "Most values are placeholders - actual data is passed at runtime via API",
    
    "logging_level": "INFO",
    "costfun": "cost",
    "optimization_time_step": 15,
    "historic_days_to_retrieve": 7,
    "method_ts_round": "nearest",
    "continual_publish": false,
    "data_path": "default",
    "set_total_pv_sell": false,
    "lp_solver": "default",
    "lp_solver_path": "empty",
    "lp_solver_timeout": 45,
    "num_threads": 0,

    "_comment_battery_control": "=== BATTERY CONTROL ===",
    "_info_nocharge": "false = Grid charging allowed (for cheap electricity)",
    "set_nocharge_from_grid": false,
    "_info_nodischarge": "true = No feed-in from battery to grid",
    "set_nodischarge_to_grid": true,
    "set_battery_dynamic": true,
    "battery_dynamic_max": 0.4,
    "battery_dynamic_min": -0.4,

    "_comment_weights": "=== BATTERY COSTS (IMPORTANT!) ===",
    "_info_weights": "These values represent costs in €/kWh for battery cycles",
    "_info_weight_charge": "0.10 = 10 cents - prevents grid charging at < 10 cents price advantage",
    "weight_battery_discharge": 0.01,
    "weight_battery_charge": 0.10,

    "_comment_sensors": "=== SENSORS (Home Assistant Entity IDs) ===",
    "_info_sensors": "These sensors are read from InfluxDB for load forecasting",
    "sensor_power_photovoltaics": "sensor.loxone_pv_power",
    "sensor_power_photovoltaics_forecast": "sensor.p_pv_forecast",
    "sensor_power_load_no_var_loads": "sensor.loxone_house_power_wo_ev",
    "sensor_replace_zero": [
        "sensor.loxone_pv_power",
        "sensor.p_pv_forecast"
    ],
    "sensor_linear_interp": [
        "sensor.loxone_pv_power",
        "sensor.loxone_house_power_wo_ev"
    ],

    "_comment_influxdb": "=== INFLUXDB CONNECTION (CHANGE THESE!) ===",
    "use_websocket": true,
    "use_influxdb": true,
    "influxdb_host": "<INFLUXDB_IP>",
    "influxdb_port": 8086,
    "influxdb_username": "<INFLUXDB_USER>",
    "influxdb_password": "<INFLUXDB_PASSWORD>",
    "influxdb_database": "smarthome",
    "influxdb_measurement": "W",
    "influxdb_retention_policy": "autogen",
    "influxdb_use_ssl": false,
    "influxdb_verify_ssl": false,

    "_comment_load": "=== LOAD FORECAST ===",
    "load_negative": false,
    "set_zero_min": true,

    "_comment_deferrable": "=== DEFERRABLE LOADS (Placeholder) ===",
    "_info_deferrable": "Define controllable loads here (e.g., EV charger)",
    "number_of_deferrable_loads": 1,
    "nominal_power_of_deferrable_loads": [10],
    "minimum_power_of_deferrable_loads": [0],
    "operating_hours_of_each_deferrable_load": [4],
    "treat_deferrable_load_as_semi_cont": [true],
    "set_deferrable_load_single_constant": [true],
    "set_deferrable_startup_penalty": [0],
    "start_timesteps_of_each_deferrable_load": [0],
    "end_timesteps_of_each_deferrable_load": [0],

    "_comment_forecast": "=== FORECAST METHODS ===",
    "_info_forecast": "These values are overwritten at runtime by Node-RED!",
    "weather_forecast_method": "open-meteo",
    "open_meteo_cache_max_age": 30,
    "load_forecast_method": "naive",
    "delta_forecast_daily": 1,
    "load_cost_forecast_method": "hp_hc_periods",

    "_comment_prices": "=== ELECTRICITY PRICES (Placeholder) ===",
    "_info_prices": "Replaced at runtime with Tibber data",
    "load_peak_hour_periods": {
        "period_hp_1": [{"start": "06:00"}, {"end": "08:00"}],
        "period_hp_2": [{"start": "17:00"}, {"end": "20:00"}]
    },
    "load_peak_hours_cost": 0.35,
    "load_offpeak_hours_cost": 0.25,
    "production_price_forecast_method": "constant",
    "_info_feedin": "CHANGE THIS: Your feed-in tariff in €/kWh",
    "photovoltaic_production_sell_price": 0.0711,

    "_comment_grid": "=== GRID CONNECTION ===",
    "maximum_power_from_grid": 15000,
    "maximum_power_to_grid": 10000,

    "_comment_pv": "=== PV SYSTEM (Placeholder) ===",
    "_info_pv": "These values are not actively used since Solcast provides the forecast",
    "set_use_pv": true,
    "set_use_adjusted_pv": false,
    "adjusted_pv_regression_model": "LassoRegression",
    "adjusted_pv_solar_elevation_threshold": 10,
    "adjusted_pv_model_max_age": 24,
    "pv_module_model": ["CSUN_Eurasia_Energy_Systems_Industry_and_Trade_CSUN295_60M"],
    "pv_inverter_model": ["Fronius_International_GmbH__Fronius_Primo_5_0_1_208_240__240V_"],
    "surface_tilt": [30],
    "surface_azimuth": [205],
    "modules_per_string": [16],
    "strings_per_inverter": [1],

    "_comment_inverter": "=== INVERTER ===",
    "inverter_is_hybrid": true,
    "inverter_ac_output_max": 10000,
    "inverter_ac_input_max": 10000,
    "inverter_efficiency_dc_ac": 1,
    "inverter_efficiency_ac_dc": 1,
    "compute_curtailment": false,

    "_comment_battery": "=== BATTERY (CHANGE THESE!) ===",
    "_info_battery": "These values MUST be adapted to your battery!",
    "set_use_battery": true,
    "_info_power": "Max charge/discharge power in Watts",
    "battery_discharge_power_max": 5000,
    "battery_charge_power_max": 5000,
    "_info_efficiency": "Efficiency (0.95 = 95%)",
    "battery_discharge_efficiency": 0.95,
    "battery_charge_efficiency": 0.95,
    "_info_capacity": "Usable capacity in Wh (not gross!)",
    "battery_nominal_energy_capacity": 8000,
    "_info_soc": "SOC limits (0-1). For Sungrow: relative between Min/Max SOC!",
    "battery_minimum_state_of_charge": 0,
    "battery_maximum_state_of_charge": 1,
    "_info_target": "Target SOC at end of optimization period (0.5 = 50%)",
    "battery_target_state_of_charge": 0.5
}
